<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Kepala: logo + nama aplikasi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_logo"
            android:contentDescription="Logo Tasirin TempMail"
            android:padding="10dp"
            android:src="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/judul_app"
                android:textColor="@color/biru_gelap"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubjudul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subjudul_awal"
                android:textColor="@color/teks_redup"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kartu alamat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Tombol salin/ganti di paling atas kartu, di atas pemilih
             layanan (permintaan owner 2026-11-25). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSalin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/biru_utama"
                android:text="@string/tombol_salin_email"
                android:textColor="@color/putih" />

            <Button
                android:id="@+id/btnGanti"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/biru_utama"
                android:text="@string/tombol_ganti_email"
                android:textColor="@color/putih" />
        </LinearLayout>

        <!-- Kolom alamat tepat di bawah tombol, pemilih layanan
             sesudahnya (permintaan owner 2026-11-25). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/label_alamat"
            android:textColor="@color/teks_utama"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_email"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@color/biru_gelap"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/label_layanan"
            android:textColor="@color/teks_utama"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerLayanan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Blok nama sendiri: disembunyikan untuk layanan yang tidak
             mendukung nama pilihan pengguna (tempmail.now). -->
        <LinearLayout
            android:id="@+id/llNamaSendiri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/label_nama_sendiri"
                android:textColor="@color/teks_utama"
                android:textStyle="bold" />

            <!-- Domain dan nama ditumpuk vertikal: sebaris bertiga membuat
                 kolom nama sempit sampai hint-nya terpotong di layar HP. -->
            <Spinner
                android:id="@+id/spinnerDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etNama"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/petunjuk_nama"
                    android:inputType="text" />

                <Button
                    android:id="@+id/btnPakai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/biru_utama"
                    android:text="@string/tombol_pakai"
                    android:textColor="@color/putih" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Spanduk kode verifikasi -->
    <LinearLayout
        android:id="@+id/llKode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_kode"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/label_kode"
            android:textColor="@color/putih" />

        <TextView
            android:id="@+id/tvKode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/putih"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSalinKode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/putih"
            android:text="@string/tombol_salin_kode"
            android:textColor="@color/biru_gelap" />
    </LinearLayout>

    <!-- Baris status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_awal"
            android:textColor="@color/teks_redup"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSegarkan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/biru_utama"
            android:text="@string/tombol_segarkan"
            android:textColor="@color/putih" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/judul_kotak_masuk"
        android:textColor="@color/teks_utama"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lvInbox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:divider="@color/garis"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/tvKosong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/kotak_kosong"
        android:textColor="@color/teks_redup" />

</LinearLayout>
