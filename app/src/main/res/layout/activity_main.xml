<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Kepala: logo + nama aplikasi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_logo"
            android:contentDescription="Logo Tasirin TempMail"
            android:padding="10dp"
            android:src="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasirin TempMail"
                android:textColor="@color/biru_gelap"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email sekali pakai • tempmail.plus"
                android:textColor="@color/teks_redup"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kartu alamat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alamat email kamu:"
            android:textColor="@color/teks_utama"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_email"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@color/biru_gelap"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSalin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/biru_utama"
                android:text="Salin Email"
                android:textColor="@color/putih" />

            <Button
                android:id="@+id/btnGanti"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/biru_utama"
                android:text="Ganti Email"
                android:textColor="@color/putih" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Pakai nama sendiri:"
            android:textColor="@color/teks_utama"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerDomain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/etNama"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="nama sendiri"
                android:inputType="text" />

            <Button
                android:id="@+id/btnPakai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/biru_utama"
                android:text="Pakai"
                android:textColor="@color/putih" />
        </LinearLayout>
    </LinearLayout>

    <!-- Spanduk kode verifikasi -->
    <LinearLayout
        android:id="@+id/llKode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_kode"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Kode verifikasi terdeteksi:"
            android:textColor="@color/putih" />

        <TextView
            android:id="@+id/tvKode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/putih"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSalinKode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/putih"
            android:text="Salin Kode"
            android:textColor="@color/biru_gelap" />
    </LinearLayout>

    <!-- Baris status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Menunggu cek pertama…"
            android:textColor="@color/teks_redup"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSegarkan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Segarkan" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Kotak masuk"
        android:textColor="@color/teks_utama"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lvInbox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:divider="@color/garis"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/tvKosong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Belum ada email masuk. Kotak masuk dicek otomatis tiap 8 detik."
        android:textColor="@color/teks_redup" />

</LinearLayout>
